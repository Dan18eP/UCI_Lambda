# ==============================================================================
# ENVIRONMENT CONFIGURATION - MONITOREO CRÍTICO UCI (LAMBDA ARCHITECTURE)
# ==============================================================================

# General
PROJECT_NAME=uci-lambda-arch
ENVIRONMENT=development

# PostgreSQL (Serving Layer)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=serving_db
POSTGRES_HOST=postgres-serving
POSTGRES_PORT=5432

# Apache Kafka (KRaft Mode - No ZooKeeper)
KAFKA_BROKER_ID=1
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_PORT_INTERNAL=9092
KAFKA_PORT_EXTERNAL=29092
KAFKA_TOPIC_VITALS=vitals-stream

# MinIO (Master Dataset Append-Only)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=data-lake
MINIO_ENDPOINT=http://minio:9000

# Apache Spark
SPARK_MASTER_PORT=7077
SPARK_MASTER_WEBUI_PORT=8080
SPARK_DRIVER_WEBUI_PORT=4040

# Apache Airflow (Batch Orchestration)
AIRFLOW_WEBSERVER_PORT=8085
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin

# Apache Atlas & OpenMetadata (Governance & Lineage)
ATLAS_PORT=21000
OPENMETADATA_PORT=8585

# FastAPI & WebSockets
BACKEND_PORT=8000
FRONTEND_PORT=3000
